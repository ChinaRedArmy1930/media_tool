    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug executable 'media_tool'",
            "cargo": {
                "args": [
                    "build",
                    "--bin=media_tool",
                    "--package=media_tool"
                ],
                "filter": {
                    "name": "media_tool",
                    "kind": "bin"
                }
            },
            "args": [
                "--input",
                "test_data/wildfires.mp3",
                "--output",
                "test_output/extracted/output.mp3",
                "--method",
                "mono_to_stereo",
                "--verbose"
            ],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug unit tests in executable 'media_tool'",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--bin=media_tool",
                    "--package=media_tool"
                ],
                "filter": {
                    "name": "media_tool",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        }
    ]
}